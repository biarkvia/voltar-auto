---
import type { ServiceId } from '../data/site';
interface Props { kind: ServiceId; }
const { kind } = Astro.props;
---
<svg class="service-icon" width="54" height="48" viewBox="0 0 56 48" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === 'diagnostika' && <>
    <rect x="7" y="7" width="42" height="29" rx="3"/><path d="M8 31h40M23 36l-1.5 5m11-5 1.5 5m-15 0h18"/>
    <path class="accent-stroke" d="M13 21h7l3-7 5 13 4.5-10 3 4H43"/>
  </>}
  {kind === 'olej' && <>
    <path d="m6 24 4-9 10 3h11l6 5 10-6 3 4-13 16H18l-7-10zm11-6 3-8h12v8M24 10V7h9"/>
    <path class="accent-stroke" d="M48.5 29s-4 5.4-4 7.7a4 4 0 0 0 8 0c0-2.3-4-7.7-4-7.7ZM18 31h11"/>
  </>}
  {kind === 'brzdy' && <>
    <path d="M44 29A18.5 18.5 0 1 1 22 6"/><circle cx="26" cy="25" r="8.7"/><circle cx="26" cy="25" r="3"/>
    <path d="m12.8 21 2.1-1.2m2.2 16.4.6-2.2m13.8 5.2 1-2.2M12 27l2 .8"/>
    <path class="accent-stroke" d="M26 5.3A20 20 0 0 1 46 25l-7 .8a13.4 13.4 0 0 0-13.8-13.4zM31 9l2.8 1.2"/>
  </>}
  {kind === 'pneuservis' && <>
    <ellipse cx="24" cy="24" rx="14" ry="19" transform="rotate(12 24 24)"/><ellipse cx="24" cy="24" rx="7" ry="11" transform="rotate(12 24 24)"/>
    <path d="m28 5.4 8 1.8c7.1 1.8 11 11.5 8.5 21.3S34.2 45 27.3 43.2L20 41.6"/>
    <path class="accent-stroke" d="m37 11 5 1.5m-3 6.4 5.3 1.4m-6.1 6.3 5.8 1.7m-9 5.2 5.8 1.8m-11 3.5 5.1 1.7"/>
  </>}
  {kind === 'klimatizace' && <>
    <path d="M28 5v38M11.6 14.5l32.8 19m-32.8 0 32.8-19"/>
    <path class="accent-stroke" d="m22.5 8.5 5.5 5 5.5-5m-11 31 5.5-5 5.5 5M12 21l7-2-1.1-7m20.2 24-1.2-7 7-2M18 36l1.1-7-7-2m32-6-7-2 1-7"/>
  </>}
  {kind === 'stk' && <>
    <path d="M20 8h-6a2 2 0 0 0-2 2v30a2 2 0 0 0 2 2h27a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2h-6"/><rect x="20" y="5" width="15" height="7" rx="2"/>
    <path class="accent-stroke" d="m18 21 2.3 2.2 4-5m-6.3 13 2.3 2.2 4-5"/><path d="M29 21h7m-7 10h7"/>
  </>}
</svg>
