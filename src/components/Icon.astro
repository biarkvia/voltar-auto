---
type Name = 'calendar' | 'message' | 'shield' | 'wrench' | 'check' | 'pin' | 'info' | 'chevron' | 'top';
interface Props { name: Name; size?: number; }
const { name, size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'calendar' && <><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M4 10h16M8 14h2m4 0h2m-8 3h2"/></>}
  {name === 'message' && <><path d="M18.5 14H10l-5 4v-4H3V4h15.5z"/><path d="M9 18h6l4.5 3v-3H22V8.5M7 8h7m-7 3h4"/></>}
  {name === 'shield' && <><path d="M12 2.5c2.7 2 5 2.7 8.2 3.1v6.1c0 5-4 8.2-8.2 10.1-4.2-1.9-8.2-5.1-8.2-10.1V5.6c3.2-.4 5.5-1.1 8.2-3.1Z"/><path d="m8.2 11.7 2.6 2.6 5-5.1"/></>}
  {name === 'wrench' && <><path d="m14.5 5.5 3.8 3.8 3.4-3.4a6.2 6.2 0 0 1-7.8 8.4L7 21a2.8 2.8 0 0 1-4-4l7-6.9a6.2 6.2 0 0 1 8-7.9z"/><path d="m5.2 18.8.4-.4"/></>}
  {name === 'check' && <path d="m5 12 4.5 4.5L19 7"/>}
  {name === 'pin' && <><path d="M19.5 10c0 5.3-7.5 11.5-7.5 11.5S4.5 15.3 4.5 10a7.5 7.5 0 1 1 15 0Z"/><circle cx="12" cy="10" r="2.6"/></>}
  {name === 'info' && <><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-9v.25"/></>}
  {name === 'chevron' && <path d="m6 9 6 6 6-6"/>}
  {name === 'top' && <path d="m6 15 6-6 6 6"/>}
</svg>
