---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="contact section" id="kontakt" aria-labelledby="contact-title" tabindex="-1">
  <div class="wrap contact-pair">
    <div class="contact-copy">
      <p class="eyebrow">Kontakt</p>
      <h2 id="contact-title">Objednat servis<span class="period">.</span></h2>
      <p>Napište, co váš vůz potřebuje. Připojte značku a model, ať máme lepší představu.</p>
      <div class="location"><Icon name="pin"/>{site.contact.location}</div>
      {!site.isDemo && site.contact.email && <a href={'mailto:' + site.contact.email}>{site.contact.email}</a>}
      {!site.isDemo && site.contact.phone && <a href={'tel:' + site.contact.phone}>{site.contact.phone}</a>}
    </div>

    <div class="form-panel">
      <p class="demo-note" id="form-note">
        <Icon name="info" size={19}/>
        {site.isDemo
          ? <span><strong>Ukázkový formulář.</strong> Použijte smyšlené údaje. Nic se neodesílá ani neukládá.</span>
          : <span>Online poptávky nyní nepřijímáme.</span>}
      </p>
      <form id="servisni-formular" method="dialog" novalidate data-demo={String(site.isDemo)} autocomplete="off" aria-labelledby="contact-title" aria-describedby="form-note">
        <fieldset disabled>
          <div class="form-grid">
            <div class="field">
              <label for="jmeno">Jméno a příjmení <span>*</span></label>
              <input id="jmeno" name="name" required maxlength="120" aria-describedby="jmeno-error" data-missing="Vyplňte jméno a příjmení."/>
              <span id="jmeno-error" class="field-error" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="email">E-mail <span>*</span></label>
              <input id="email" name="email" type="email" required maxlength="254" aria-describedby="email-error" data-missing="Vyplňte e-mailovou adresu."/>
              <span id="email-error" class="field-error" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="telefon">Telefon <small>(nepovinné)</small></label>
              <input id="telefon" name="phone" type="tel" maxlength="40"/>
            </div>
            <div class="field">
              <label for="sluzba">Typ služby</label>
              <div class="select-wrap">
                <select id="sluzba" name="service">
                  <option value="">Vyberte službu</option>
                  {site.services.map(s => <option value={s.id}>{s.title}</option>)}
                  <option value="jina">Potřebuji poradit</option>
                </select>
                <Icon name="chevron" size={16}/>
              </div>
            </div>
            <div class="field full-field">
              <label for="zprava">Zpráva <span>*</span></label>
              <textarea id="zprava" name="message" rows="4" required maxlength="4000" aria-describedby="zprava-error" data-missing="Napište krátkou zprávu o svém voze."></textarea>
              <span id="zprava-error" class="field-error" aria-live="polite"></span>
            </div>
          </div>
          <div class="form-footer">
            <small>* Povinné údaje</small>
            <button class="button button-orange" type="submit">Odeslat poptávku</button>
          </div>
        </fieldset>
        <p class="form-status" role="status">{site.isDemo && 'Pro vyzkoušení formuláře povolte JavaScript.'}</p>
      </form>
    </div>
  </div>
</section>
<script src="../scripts/inquiry.ts"></script>
